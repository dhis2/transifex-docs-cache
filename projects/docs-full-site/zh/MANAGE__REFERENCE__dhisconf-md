```属性
# ----------------------------------------------------------------------
# PostgreSQL 数据库连接 [必填]
# ----------------------------------------------------------------------

# Hibernate SQL 方言
connection.dialect = org.hibernate.dialect.PostgreSQLDialect

# JDBC 驱动程序类
connection.driver_class = org.postgresql.Driver

# 数据库连接 URL
connection.url = jdbc:postgresql:dhis2

# 数据库用户名
connection.username = dhis

# 数据库密码（敏感信息）
connection.password = xxxx

# ----------------------------------------------------------------------
# PostgreSQL 数据库连接 [可选]
# ----------------------------------------------------------------------

# 连接池的最大规模（默认：80）
connection.pool.max_size = 80

# 自 v43 起已弃用。连接池在任何给定时刻将维持的最小连接数（默认： 5）。
connection.pool.min_size = 5

# 自 v43 起已弃用。连接池在启动时尝试获取的连接数。该值应在 minPoolSize 和 maxPoolSize 之间
connection.pool.initial_size = 5

# 自 v43 起已弃用。确定当连接池耗尽时，将尝试获取的连接数。
connection.pool.acquire_incr = 5

# 连接在池中处于闲置状态但未被使用时，允许保留的时间（以秒为单位），超过该时间将被丢弃。零表示闲置连接永不过期。（默认值：7200）
connection.pool.max_idle_time = 7200

# 自 v43 起已弃用。超过 minPoolSize 的连接在被清除前，允许在连接池中闲置的秒数（默认：0）
connection.pool.max_idle_time_excess_con = 0

# 自 v43 起已弃用。 如果该数值大于 0，dhis2 将每隔此数值所代表的秒数，对所有空闲、已加入连接池但未被签出的连接进行检测。（默认值：0）
connection.pool.idle.con.test.period = 0

# 自 v43 起已弃用。如果启用，每次连接签出时都会执行一项操作，以验证连接是否有效。（默认：false）
connection.pool.test.on.checkout = false

# 自 v43 起已弃用。如果启用，每次连接归还时都会异步执行一项操作，以验证连接是否有效。（默认：on）
connection.pool.test.on.checkin = on

# 定义将用于所有连接测试的查询语句。理想情况下无需此配置，因为 PostgreSQL 驱动程序已提供高效的测试查询。此配置仅供评估之用，除非有特殊原因，否则请勿使用。
connection.pool.preferred.test.query = select 1

# 自 v43 起已弃用。配置 dhis2 用于 JDBC 操作的辅助线程数量。（默认：3）
connection.pool.num.helper.threads = 3

# Hikari DB 连接池功能。连接池超时：设置客户端从连接池中等待连接的最长时长（以毫秒为单位）。（默认：30ms）。
connection.pool.timeout = 30

# 设置 Hikari 连接池等待连接被验证为有效的时间上限（以毫秒为单位）。（默认：5 毫秒）。
connection.pool.validation_timeout = 5

# 数据库数据源池类型。支持的池类型包括：hikari（默认）、c3p0（已弃用）、unpooled
